# Passphrase for the Stage Screen and Host Console. Set this before the event.
ADMIN_KEY="something-only-you-know"

# Folder where the live show state (questions, votes, confessions) is saved so
# it survives a restart. Defaults to ./data — point it at a persistent disk if
# your host has one (on Render: attach a Disk and mount it here).
# DATA_DIR=/var/data

# PORT=3000
